<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/4.8.3/spotbugs/etc/findbugsfilter.xsd">

  <!--
    Both maps are wrapped with Collections.unmodifiableMap(Map.copyOf(...))
    in their constructors, so the references returned by these getters are
    immutable. SpotBugs cannot infer that, and flags EI_EXPOSE_REP.
  -->
  <Match>
    <Class name="com.unifieddataprocessing.pubsub.Message"/>
    <Method name="getAttributes"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="com.unifieddataprocessing.pubsub.kafka.KafkaConsumerConfig"/>
    <Method name="getExtras"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="com.unifieddataprocessing.pubsub.kinesis.KinesisConsumerConfig"/>
    <Method name="getStartingPositionByShard"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="com.unifieddataprocessing.pubsub.kafka.KafkaProducerConfig"/>
    <Method name="getExtras"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="com.unifieddataprocessing.pubsub.pulsar.PulsarPublisherConfig"/>
    <Method name="getClientExtras"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="com.unifieddataprocessing.pubsub.pulsar.PulsarPublisherConfig"/>
    <Method name="getProducerExtras"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="com.unifieddataprocessing.pubsub.PublishBatchException"/>
    <Method name="getSucceeded"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="com.unifieddataprocessing.pubsub.bridge.ChannelOptions"/>
    <Method name="getTopicConfigs"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <!--
    ValidationResult.errors() is the synthetic record accessor for a List
    that was already defensively copied (List.copyOf) in the compact
    constructor. SpotBugs cannot infer that the returned list is immutable.
  -->
  <Match>
    <Class name="com.unifieddataprocessing.pubsub.schema.ValidationResult"/>
    <Method name="errors"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <!--
    SchemaRegistry is a stateful service shared between the bridge and its
    control-plane caller by design — getter / builder setter holding the same
    reference is intentional, not a leak.
  -->
  <Match>
    <Class name="com.unifieddataprocessing.pubsub.bridge.DataBridgeConfig"/>
    <Method name="schemaRegistry"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="com.unifieddataprocessing.pubsub.bridge.DataBridgeConfig$Builder"/>
    <Method name="schemaRegistry"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <!--
    DataBridge.sleeper is wired into the test ctor for #19 but only read once
    poll-failure backoff lands in chunk #21. Remove this entry then.
  -->
  <Match>
    <Class name="com.unifieddataprocessing.pubsub.bridge.DataBridge"/>
    <Field name="sleeper"/>
    <Bug pattern="URF_UNREAD_FIELD"/>
  </Match>
</FindBugsFilter>
